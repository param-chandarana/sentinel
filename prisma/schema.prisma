generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guild {
  id                      String   @id
  prefix                  String   @default("?")
  active                  Boolean  @default(true)
  modLogChannel           String?  @map("mod_log_channel")
  banLogChannel           String?  @map("ban_log_channel")
  joinLogChannel          String?  @map("join_log_channel")
  leaveLogChannel         String?  @map("leave_log_channel")
  muteRole                String?  @map("mute_role")
  countingChannel       String?  @map("counting_channel")
  countingBlacklistRole String?  @map("counting_blacklist_role")
  countingWindowMs        Int      @default(600000) @map("counting_window_ms")
  createdAt               DateTime @default(now()) @map("created_at")

  permissionRoles PermissionRole[]
  infractions     Infraction[]
  customMessages  CustomMessage[]
  inviteCache     InviteCache[]

  @@map("guilds")
}

model PermissionRole {
  guildId  String @map("guild_id")
  category String
  roleId   String @map("role_id")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, category, roleId])
  @@map("permission_roles")
}

model Infraction {
  id              Int       @id @default(autoincrement())
  caseNumber      Int       @map("case_number")
  guildId         String    @map("guild_id")
  userId          String    @map("user_id")
  moderatorId     String    @map("moderator_id")
  type            String
  reason          String?
  durationSeconds Int?      @map("duration_seconds")
  expiresAt       DateTime? @map("expires_at")
  active          Boolean   @default(true)
  roleDeleted     Boolean   @default(false) @map("role_deleted")
  dmStatus        String    @default("pending") @map("dm_status")
  createdAt       DateTime  @default(now()) @map("created_at")

  guild   Guild     @relation(fields: [guildId], references: [id])
  dmQueue DmQueue[]

  @@unique([guildId, caseNumber])
  @@map("infractions")
}

model CustomMessage {
  guildId    String @map("guild_id")
  actionType String @map("action_type")
  template   String

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, actionType])
  @@map("custom_messages")
}

model InviteCache {
  guildId    String  @map("guild_id")
  inviteCode String  @map("invite_code")
  uses       Int     @default(0)
  inviterId  String? @map("inviter_id")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, inviteCode])
  @@map("invite_cache")
}

model DmQueue {
  id             Int       @id @default(autoincrement())
  userId         String    @map("user_id")
  infractionId   Int?      @map("infraction_id")
  messageContent String    @map("message_content")
  attempts       Int       @default(0)
  lastAttempt    DateTime? @map("last_attempt")
  nextRetry      DateTime? @map("next_retry")
  status         String    @default("pending")
  createdAt      DateTime  @default(now()) @map("created_at")

  infraction Infraction? @relation(fields: [infractionId], references: [id])

  @@map("dm_queue")
}
