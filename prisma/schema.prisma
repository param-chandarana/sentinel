generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GuildConfig {
  guildId           String   @id @map("guild_id")
  blacklistRoleId   String?  @map("blacklist_role_id")
  countingChannelId String?  @map("counting_channel_id")
  windowMs          Int      @default(600000) @map("window_ms")
  prefix            String   @default("?")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("guild_configs")
}
