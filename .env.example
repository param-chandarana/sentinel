BOT_TOKEN=your_bot_token_here # Discord Bot Token Get yours from https://discord.com/developers/applications
CLIENT_ID=your_application_client_id_here # Required for slash command deployment (Application ID from Discord Developer Portal)
GUILD_ID= # Optional: set to deploy slash commands to a single guild (instant). Leave empty for global deploy.
NODE_ENV=development
POSTGRES_USER=botuser
POSTGRES_PASSWORD=your_strong_password
POSTGRES_DB=discordbot
DATABASE_URL=your_database_url_here
DB_SSL=false
COUNTING_BOT_ID=id_of_counting_bot_here
REQUIRE_MEMBER_INTENT=false # Set to true once Server Members Intent is approved by Discord